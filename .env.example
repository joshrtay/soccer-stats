# Coach login password (any string).
ADMIN_PASSWORD=change-me

# 32+ random bytes used to sign the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-bytes-of-randomness

# Auto-provisioned by Vercel Blob integration. Locally, run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
